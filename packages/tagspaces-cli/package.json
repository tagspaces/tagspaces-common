{
  "name": "@tagspaces/shell",
  "description": "Shell script for creating thumbnails and search index for the TagSpaces applications",
  "version": "4.8.9",
  "author": "TagSpaces Authors <contact@tagspaces.org>",
  "license": "MIT",
  "scripts": {
    "build:dev": "webpack --config webpack.config.js --mode development",
    "build": "rimraf build && webpack --config webpack.config.js --mode production",
    "node-install": "rimraf package-lock.json && rimraf node_modules && npx cross-env PD_PLATFORM=node npm install && npm dedupe",
    "gen-index": "node bin/cli.js -m indexer ./__test__",
    "gen-index-dev": "node bin/clidev.js -m indexer ./__test__/indexingLocation",
    "meta-clean": "node bin/cli.js -m metacleaner -a false ./__test__",
    "meta-clean-dev": "node bin/clidev.js -m metacleaner -a false ./__test__",
    "gen-thumbnails": "node bin/cli.js -m thumbgen ./__test__",
    "gen-thumbnails-dev": "node bin/clidev.js -m thumbgen ./__test__",
    "test": "npm run build && jest",
    "pkg-publish": "npm run node-install && npm run build:prod && npm publish --access public"
  },
  "bin": {
    "tscmd": "./bin/cli.js"
  },
  "dependencies": {
    "@tagspaces/tagspaces-metacleaner": "^4.8.9",
    "@tagspaces/tagspaces-pdf-extraction": "^4.8.4",
    "@tagspaces/tagspaces-search": "^4.8.9",
    "@tagspaces/tagspaces-workers": "^4.8.9",
    "chalk": "4.1.2",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "webpack": "5.105.4",
    "webpack-cli": "7.0.2"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "yarn": "please-use-npm",
    "npm": ">= 6.14.15"
  },
  "gitHead": "f000d89f40d3aad60711c34693acb3630dbd4f1f"
}
